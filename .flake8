[flake8]
max-line-length = 120
extend-ignore =
    E203,
    W503,
    E402
exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    .pytest_cache,
    .ruff_cache,
    .streamlit,
    .windsurf,
    .vscode,
    .devcontainer,
    .claude,
    notebooks,
    outputs,
    uploads,
    references,
    docs,
    dashboard.py,
    dashboard_refatorado.py,
    dashboard_supabase.py
per-file-ignores =
    __init__.py:F401
    src/dashboard/ui/theme_claro_avancado.py:E501
    src/dashboard/ui/theme.py:E501
