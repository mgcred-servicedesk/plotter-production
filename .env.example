# Configurações do Dashboard de Performance Comercial
#
# Credenciais lidas por src/config/supabase_client.py, nesta ordem:
#   1. st.secrets["database"]  (Streamlit Cloud → .streamlit/secrets.toml)
#   2. variáveis de ambiente / .env  (desenvolvimento local)

# Supabase (obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co
# Use APENAS a chave anon (publica). A service_role bypassa RLS
# e nao deve ser usada na app — apenas em scripts admin offline.
SUPABASE_KEY=sua-chave-anon

# Chat de IA multi-provider (opcional): OpenRouter + Anthropic + OpenAI
# Sem chave válida para o provider selecionado, o chat mostra aviso sem
# quebrar o resto do dashboard.

# OpenRouter (padrão) — gateway compatível com a API da OpenAI, dá
# acesso a modelos de vários provedores com uma chave só. O modelo pode
# ser trocado em tempo real no seletor da aba Assistente de IA; o valor
# abaixo é só o padrão inicial.
# Chave: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.8-flash
# Identificação opcional da app nos rankings da OpenRouter (não é
# credencial, não altera roteamento).
OPENROUTER_APP_TITLE=MGCred Dashboard
OPENROUTER_APP_URL=

# Providers diretos (opcionais) — usados se um perfil for apontado para
# eles, ou como fallback. Ao contrário da OpenRouter, o modelo é fixo
# aqui: não há seletor na aba.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

# Seleção de provider por perfil (openrouter | anthropic | openai)
CHAT_IA_PROVIDER_DEFAULT=openrouter
CHAT_IA_PROVIDER_ADMIN=openrouter
CHAT_IA_PROVIDER_GESTOR=openrouter
CHAT_IA_PROVIDER_GERENTE_COMERCIAL=openrouter
CHAT_IA_PROVIDER_SUPERVISOR=openrouter
CHAT_IA_PROVIDER_CONSULTOR=openrouter

# Estratégia de fallback:
# - friendly_error
# - retry_same_provider_once
# - switch_provider_once
CHAT_IA_FALLBACK_MODE=switch_provider_once
CHAT_IA_FALLBACK_PROVIDER=openrouter
