# Configurações do Dashboard de Performance Comercial
#
# Credenciais lidas por src/config/supabase_client.py, nesta ordem:
#   1. st.secrets["database"]  (Streamlit Cloud → .streamlit/secrets.toml)
#   2. variáveis de ambiente / .env  (desenvolvimento local)

# Supabase (obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co
# Use APENAS a chave anon (publica). A service_role bypassa RLS
# e nao deve ser usada na app — apenas em scripts admin offline.
SUPABASE_KEY=sua-chave-anon

# Chat de IA multi-provider (opcional): Anthropic + OpenAI
# Sem chave válida para o provider selecionado, o chat mostra aviso sem
# quebrar o resto do dashboard.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

# Seleção de provider por perfil (anthropic | openai)
CHAT_IA_PROVIDER_DEFAULT=anthropic
CHAT_IA_PROVIDER_ADMIN=anthropic
CHAT_IA_PROVIDER_GESTOR=anthropic
CHAT_IA_PROVIDER_GERENTE_COMERCIAL=anthropic
CHAT_IA_PROVIDER_SUPERVISOR=anthropic
CHAT_IA_PROVIDER_CONSULTOR=anthropic

# Estratégia de fallback:
# - friendly_error
# - retry_same_provider_once
# - switch_provider_once
CHAT_IA_FALLBACK_MODE=switch_provider_once
CHAT_IA_FALLBACK_PROVIDER=openai
